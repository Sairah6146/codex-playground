{
  "name": "podcast-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Podcast discovery and guest-matching platform — MVP with search and match scoring.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "seed:reset": "rm -f server/db/podcast_connect.db* && node -e \"require('./server/db').getDb()\"",
    "test:engine": "node server/test-engine.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^4.0.0"
  }
}
